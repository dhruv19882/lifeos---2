  "categories": ["productivity", "health", "finance", "education"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Add expense", "url": "./index.html#money", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Today's workout", "url": "./index.html#fitness", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Study", "url": "./index.html#study", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
