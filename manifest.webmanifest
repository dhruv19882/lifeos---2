{
  "name": "LifeOS: Personal Life Operating System",
  "short_name": "LifeOS",
  "description": "Routine, fitness coach, Indian nutrition, US CMA study, career, work and money in one local-first app.",
  "id": "./",
  "start_url": "./index.html#home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a0a0c",
